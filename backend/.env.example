# Copy this file to backend/.env and fill it in. backend/.env is never committed.

# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# 1 for local development, 0 (or unset) in production.
DJANGO_DEBUG=1

# Comma-separated. Leave empty for local development with DJANGO_DEBUG=1.
DJANGO_ALLOWED_HOSTS=

# Time zone the canteen runs in, e.g. America/Los_Angeles. Cut-off times use it.
DJANGO_TIME_ZONE=UTC

# Comma-separated origins of the React app.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional. Leave blank to print emails (e.g. password reset links) to the console.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_HOST=smtp.mail.yahoo.com
EMAIL_PORT=587
DEFAULT_FROM_EMAIL=
